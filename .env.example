# Reso AI - Environment Variables Configuration

# Google Gemini API Key (Required for Agent reasoning and RAG answers)
# Get your API key at: https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here

# LLM Model Name
LLM_MODEL=gemini-2.5-flash

# MongoDB Database Configuration (Falls back to in-memory store if MongoDB is not running)
MONGODB_URI=mongodb://localhost:27017
MONGODB_DB_NAME=reso_ai_db

# ChromaDB Vector Storage Directory
CHROMA_PERSIST_DIRECTORY=./chroma_db

# Knowledge Base Directory & Retrieval Settings
KNOWLEDGE_BASE_DIR=./knowledge_base
TOP_K_RESULTS=4

# Application Logging Level (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=INFO

# Optional HuggingFace Token (used if using local HF embeddings fallback)
HF_TOKEN=
